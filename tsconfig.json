{
	"compilerOptions": {
		"module": "commonjs",
		"target": "es2020",
        "lib": [
            "es2020"
        ],
		"types": [
			"node",
			"vscode"
		],
		"strict": false,
		"skipLibCheck": true,
		"outDir": "out",
		"rootDir": ".",
		"sourceMap": true
	},
	"exclude": [
		"node_modules",
		".history"
	]
}
